# Server-only settings. Never prefix AWS credentials or runtime settings with VITE_.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Optional named profile from your normal AWS credential chain (for example SSO).
# AWS_PROFILE=your-profile

# Empty = invoke the local Strands server. Set after CDK deployment to use AWS.
AGENTCORE_RUNTIME_ARN=
AGENT_LOCAL_URL=http://127.0.0.1:8080
