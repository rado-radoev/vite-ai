{
  "name": "vite-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "concurrently --kill-others -n web,agent \"npm:dev:web\" \"npm:dev:agent\"",
    "dev:web": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.cjs dev",
    "dev:agent": "node --env-file-if-exists=.env --import tsx agent/server.ts",
    "build:agent": "tsc -p agent/tsconfig.json",
    "start": "node --env-file-if-exists=.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run build:agent",
    "cdk": "cdk",
    "cdk:synth": "cdk synth --strict",
    "mcp:inspect": "npx @modelcontextprotocol/inspector uvx strands-agents-mcp-server",
    "mcp:check": "npx @modelcontextprotocol/inspector --cli uvx strands-agents-mcp-server --method tools/list"
  },
  "engines": { "node": ">=22.22.0" },

  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1178.0",
    "@fontsource-variable/geist": "^5.3.0",

    "@react-router/node": "^8.5.3",
    "@react-router/serve": "^8.5.3",
    "@strands-agents/sdk": "^1.26.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "isbot": "^5.1.36",
    "lucide-react": "^1.81.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "shadcn": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/fs-routes": "^8.5.3",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.278.0",
    "concurrently": "^10.0.7",
    "constructs": "^10.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.2"
  }
}
